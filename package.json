{
  "name": "@aliou/vite-plugin-obsidian",
  "version": "0.2.0",
  "description": "Vite plugin for building Obsidian plugins",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -noEmit && unbuild",
    "typecheck": "tsc -noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome check --write",
    "version": "pnpm exec changeset version"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "builtin-modules": "^5.4.0"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.14.0",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.1",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.28.5",
  "publishConfig": {
    "access": "public"
  },
  "funding": "https://github.com/sponsors/aliou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aliou/vite-plugin-obsidian.git"
  },
  "homepage": "https://github.com/aliou/vite-plugin-obsidian#readme",
  "bugs": "https://github.com/aliou/vite-plugin-obsidian/issues"
}
